# ─── Backend Environment Variables ────────────────────────────────────────────
# Deployment target: Railway or Render (Docker-based)
# NOTE: Vercel does NOT support Java/JVM backends. Use Railway or Render instead.
#
# For Railway: set these in the Railway project dashboard → Variables tab
# For Render:  set these in the Render service dashboard → Environment tab
# ──────────────────────────────────────────────────────────────────────────────

# Spring Profile (use 'dev' for Railway dev service, 'prod' for production)
SPRING_PROFILES_ACTIVE=dev

# MongoDB Connection (Required)
# Example Atlas URI: mongodb+srv://<user>:<password>@cluster0.mongodb.net
MONGODB_URI_DEV=mongodb://localhost:27017
MONGODB_DATABASE_DEV=dev

# API Key Security
NCOP_API_KEY=ncop-dev-api-key-2026

# Port — set automatically by Railway/Render; defaults to 8080 locally
# PORT=8080   ← do NOT set this manually; the platform injects it

# Google Cloud Storage — commented out (migrated to local disk storage)
# Re-enable and restore google-cloud-storage dependency in pom.xml if needed.
# GCS_BUCKET_NAME=
# GCS_PROJECT_ID=
# GCS_CREDENTIALS_PATH=
